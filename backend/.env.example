# Soi Đề AI dùng biến môi trường nào (API key cắm sau).
PORT=8010
DATABASE_PATH=./data/soide.db
QUOTA_FREE=30 (câu/tháng cho gói free; gói premium = không giới hạn)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
SOLVER_TIMEOUT_MS=5000
PYTHON_BIN=python
FILE_MAX_MB=10
FILE_MAX_PAGES=50
# EXTRACT_MAX_MB=5 (route trích đề nhanh /api/files/extract; không vượt FILE_MAX_MB)
# FILE_MAX_UNCOMPRESSED_MB=100 (tổng bung nén zip cho phép — chống zip-bomb)
# FILE_MAX_ZIP_ENTRIES=2000 (số mục nén tối đa trong 1 file)
# EXTRACT_TIMEOUT_MS=15000 (timeout trích xuất DOCX/PDF)
# FILE_ALLOWED=docx,pdf,txt (pptx trả stub PPTX_NOT_SUPPORTED_YET)
# --- Giới hạn SÁCH (T14): tách riêng khỏi đề thi vì 1 chương SGK dài hơn nhiều ---
# BOOK_MAX_MB=30
# BOOK_MAX_PAGES=400
# BOOK_MAX_CHARS=300000 (1 chương SGK 30-60 trang ~60k-150k ký tự; đề thi chỉ 20k)
# BOOK_MAX_UNCOMPRESSED_MB=200
# BOOK_MAX_ZIP_ENTRIES=4000
# BOOK_EXTRACT_TIMEOUT_MS=60000
# LLM_API_KEY=  (để trống: app chạy rules-only + nhãn "chưa cấu hình key")
# LLM_PROVIDER=gemini  (gemini | mock — mock chỉ để test, 0 phí)
# LLM_MODEL=gemini-2.5-flash-lite (T19 tầng 1 — rẻ nhất, đủ validate tiếng Việt)
# LLM_MODEL_STRONG=gemini-3.8-flash (T19 tầng 2 — chỉ leo cho câu blocker chưa ngã ngũ)
# LLM_BASE_URL=https://generativelanguage.googleapis.com
# LLM_TIMEOUT_MS=20000
# LLM_MAX_INPUT_TOKENS=2000
# LLM_MAX_OUTPUT_TOKENS=800
# LLM_MAX_QUESTIONS=10 (AI-check tối đa 10 câu/lượt; phần còn lại báo "chưa kiểm tra AI")
# LLM_SOLVE_MAX_OUTPUT_TOKENS=800 (lời giải dài hơn review nên tách riêng)
# LLM_MAX_SOLVE_QUESTIONS=5 (solver 1 câu/lượt nên giới hạn riêng, rẻ hơn)
# T18: ĐIỀN GIÁ THẬT, nếu không costUSD luôn = 0 (tiêu tiền mà không biết bao nhiêu).
#   gemini-2.5-flash-lite = $0.10 / $0.40 ; gemini-3.8-flash = $0.375 / $1.875
# LLM_PRICE_IN=0.10  (USD/1M input tokens)
# LLM_PRICE_OUT=0.40 (USD/1M output tokens)
# EMBED_PROVIDER=gemini  (gemini | hash | mock — T16: dùng gemini ở đường chính; hash chỉ để test offline)
# EMBED_MODEL=gemini-embedding-001
# EMBED_API_KEY=  (riêng cho embedding; để trống thì dùng LLM_API_KEY; chỉ ở server)
# EMBED_MAX_CHUNKS=2000
# EMBED_MAX_CHARS=2000000
# EMBED_PRICE_PER_1K_CHARS=0 (USD/1k ký tự embedding)
# RAG_TOP_K=3
# RAG_MIN_SCORE=0.15 (ngưỡng cosine; tăng nếu nhiễu)
# RAG_MAX_SCAN=20000 (số chunk tối đa quét mỗi truy vấn; đo thật 20k chunks ~390ms)
# CHUNK_VECTOR_DIM=512 (chiều vector lưu BLOB float32 = 512*4 = 2048 byte/chunk)
